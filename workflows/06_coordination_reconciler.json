{
  "name": "H@H 06 — Closed-Loop Care Reconciler",
  "nodes": [
    {
      "id": "672be80b-d591-5a4d-bac2-714e8329da5e",
      "name": "Every 15 Minutes — Safety Reconciliation",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "f68a3a95-0f55-5b48-95bc-077f41aab44a",
      "name": "Reconcile Checkins Data Gaps and Task SLAs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/coordination/watch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.HAH_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 45000
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes — Safety Reconciliation": {
      "main": [
        [
          {
            "node": "Reconcile Checkins Data Gaps and Task SLAs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "saveManualExecutions": false,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
