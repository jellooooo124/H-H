        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({case_id: $json.case_id}) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "1222cc29-e9ee-552f-afa7-194f29475dca",
