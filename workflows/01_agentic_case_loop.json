      "position": [
        240,
        250
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.HAH_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({case_id: $json.body.case_id}) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "39b6484a-d179-5f7c-9c19-73f36626dea0",
