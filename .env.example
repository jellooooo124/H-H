# Demo only. Generate secrets using: python scripts/generate_secrets.py
APP_INTERNAL_KEY=REPLACE_WITH_RANDOM_64_HEX
APP_TOKEN_SECRET=REPLACE_WITH_RANDOM_64_HEX
APP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PUBLIC_BASE_URL=http://localhost:8000
N8N_WEBHOOK_URL=http://n8n:5678/webhook/hah-case-intake
# Educational only: if unset real agents fail closed. Never submit actual PHI.

# V2.2: API uses actual PostgreSQL by default in Docker Compose.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LONG_PASSWORD_URL_SAFE
# Separate access administrator secret; NEVER pass this into n8n.
APP_ADMIN_KEY=REPLACE_WITH_RANDOM_64_HEX
# Course mode: demo JWT (HS256). OIDC mode: external RS256 provider.
AUTH_MODE=demo
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLINICIAN_GROUP=hah-clinician
OIDC_PATIENT_GROUP=hah-patient
# Never paste real patient records into the system.
